# Copy this file to .env and fill in your own values. .env is git-ignored.

# Supabase: Project Settings -> API. Use the URL and the publishable (anon) key,
# never the secret / service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# TMDB "API Read Access Token" (the long eyJ... one), from https://www.themoviedb.org/settings/api
# No VITE_ prefix on purpose: it stays on the server and never reaches the browser.
TMDB_TOKEN=
